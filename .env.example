# TrabzonİşBul yönetici hesabı yapılandırması
#
# Bu dosya örnek amaçlıdır. Kopyalayıp `.env` olarak kaydedin ve
# gizli bilgilerinizi buraya yerleştirin. `.env` dosyası depoya
# eklenmez.

# Yönetici giriş bilgileri — düz değer olarak kullanmak için açın
# ve kendi e-posta/şifrenizi yazın.
#ADMIN_EMAIL=your-admin-email@example.com
#ADMIN_PASSWORD=your-strong-password

# Alternatif olarak `bcrypt` ile hashlenmiş değerleri kullanabilirsiniz.
# Hash'leri oluşturduğunuzda aşağıdaki satırları açıp düz değerleri
# yorum satırına alın.
#ADMIN_EMAIL_HASH=
#ADMIN_PASSWORD_HASH=

# Oturum süresi (ms cinsinden). Varsayılan 12 saattir.
#ADMIN_SESSION_TTL=43200000
